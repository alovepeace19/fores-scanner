      if (absVal >= 80) tier = 'extreme';
      else if (absVal >= 30) tier = 'strong';
      else if (absVal >= 10) tier = 'medium';
    } else { 
      if (absVal >= 10000000) tier = 'extreme';
      else if (absVal >= 3000000) tier = 'strong';
      else if (absVal >= 500000) tier = 'medium';
    }

