  const getMarketState = (m) => {
    const dominantRatio = Math.max(m.yesRatio, m.noRatio);
    const dominantSide = m.yesRatio > m.noRatio ? 'YES' : 'NO';
    const domDelta = dominantSide === 'YES' ? (m.yesOIChangeRaw || 0) : (m.noOIChangeRaw || 0);
    const oppDelta = dominantSide === 'YES' ? (m.noOIChangeRaw || 0) : (m.yesOIChangeRaw || 0);
    const totalOIDelta = (m.yesOIChangeRaw || 0) + (m.noOIChangeRaw || 0);

    if (m.vol24hPercent > 100 && (m.liquidityRaw || 0) < 500000) return "HOT / NOISY";
    if (m.vol24hPercent > 80 && domDelta < 0 && oppDelta > 0) return "EARLY REVERSAL";
    if (m.vol24hPercent > 50 && totalOIDelta > 0 && domDelta > (Math.abs(oppDelta) * 3) && dominantRatio > 65 && oppDelta <= 0) return "STRONG TREND";
    if (m.vol24hPercent > 0 && domDelta > 0 && oppDelta <= 0 && dominantRatio >= 60 && dominantRatio <= 75) return "SMART ACCUMULATION";
    if (m.vol24hPercent <= 15 && totalOIDelta > 0) return "POSITION BUILDING";
    return "BALANCED";
  };

