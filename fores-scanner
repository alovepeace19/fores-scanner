      <style>{`
        @keyframes flow-in-streak {
          0% { transform: translateX(-100%); opacity: 0; }
          20% { opacity: 0.8; }
          80% { opacity: 0.8; }
          100% { transform: translateX(200%); opacity: 0; }
        }
        @keyframes flow-out-streak {
          0% { transform: translateX(200%); opacity: 0; }
          20% { opacity: 0.8; }
          80% { opacity: 0.8; }
          100% { transform: translateX(-100%); opacity: 0; }
        }
        .animate-flow-streak-right { animation: flow-in-streak 2.5s infinite linear; }
        .animate-flow-streak-left { animation: flow-out-streak 2.5s infinite linear; }
      `}</style>

      {/* Navigation Header */}
      <header className={`h-[60px] border-b ${borderColor} ${headerBg} flex items-center px-6 shrink-0 z-50`}>
        <div className="flex items-center gap-12 w-full">
          <div className="flex items-center gap-2.5">
            <div className={`w-7 h-7 ${isDark ? 'bg-white shadow-[0_0_15px_rgba(255,255,255,0.3)]' : 'bg-neutral-900'} rounded flex items-center justify-center`}>
              <Zap className={`${isDark ? 'text-black' : 'text-white'} w-4 h-4 fill-current`} />
            </div>
            <span className={`text-lg font-black tracking-[-0.05em] ${isDark ? 'text-white' : 'text-neutral-900'} uppercase italic`}>Fores</span>
          </div>
          <nav className="flex items-center gap-1">
            {['Scanner', 'Alpha Feed', 'Whale Watch', 'Intelligence'].map((tab) => (
              <button 
                key={tab} 
                onClick={() => setActiveTab(tab)} 
                className={`px-4 py-2 text-[11px] font-bold uppercase tracking-widest transition-all ${
                  activeTab === tab 
                  ? `${isDark ? 'text-white bg-white/15' : 'text-neutral-900 bg-neutral-200'} rounded-md` 
                  : `text-neutral-500 ${isDark ? 'hover:text-white' : 'hover:text-neutral-900'}`
                }`}
              >
                {tab}
              </button>
            ))}
          </nav>
          <div className="relative flex-grow max-w-md ml-4">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-neutral-500" />
            <input 
              type="text" 
              placeholder="Search markets..." 
              className={`w-full ${isDark ? 'bg-[#141414]' : 'bg-neutral-100'} border ${borderColor} rounded-lg py-2 pl-10 pr-4 text-xs focus:outline-none focus:ring-1 ${isDark ? 'focus:ring-white/30' : 'focus:ring-neutral-900/30'} transition-all ${isDark ? 'text-neutral-400 placeholder-neutral-600' : 'text-neutral-900 placeholder-neutral-400'}`} 
              value={searchQuery} 
              onChange={(e) => setSearchQuery(e.target.value)} 
            />
          </div>
          <div className="flex items-center gap-4 ml-auto">
            <button onClick={toggleTheme} className={`p-2 rounded-lg border ${borderColor} ${isDark ? 'bg-[#141414]' : 'bg-neutral-100'} hover:bg-white/5 transition-colors`}>
              {isDark ? <Sun className="w-4 h-4 text-white" /> : <Moon className="w-4 h-4 text-neutral-600" />}
            </button>
          </div>
        </div>
      </header>

      {/* Control Bar */}
      <div className={`h-[56px] border-b ${borderColor} ${isDark ? 'bg-[#080808]' : 'bg-neutral-50'} flex items-center px-6 gap-6 shrink-0`}>
        <div className="flex items-center gap-2">
          <span className="text-[10px] font-black uppercase tracking-widest text-neutral-500 mr-2">Filters:</span>
          {["STRONG TREND", "SMART ACCUMULATION", "POSITION BUILDING"].map(sig => (
            <button 
              key={sig} 
              onClick={() => toggleSignalFilter(sig)} 
              className={`px-3 py-1.5 text-[9px] font-black rounded-sm border transition-all ${activeSignalFilters.includes(sig) ? 'bg-white text-black border-white' : 'bg-transparent border-[#222222] text-neutral-500 hover:text-neutral-200'}`}
            >
              {sig}
            </button>
          ))}
        </div>
        <div className="h-5 w-[1px] bg-[#222222]" />
        <button onClick={() => setHidePassiveHot(!hidePassiveHot)} className="flex items-center gap-2 group">
          <div className={`w-4 h-4 rounded-sm border flex items-center justify-center transition-all ${hidePassiveHot ? 'bg-emerald-500 border-emerald-500' : 'border-[#444444] group-hover:border-neutral-500'}`}>
            {hidePassiveHot && <Check className="w-3 h-3 text-black stroke-[4px]" />}
          </div>
          <span className={`text-[10px] font-black uppercase tracking-widest ${hidePassiveHot ? 'text-emerald-500' : 'text-neutral-500'}`}>Hide Passive / Hot</span>
        </button>

        {/* CUSTOM INSTITUTIONAL SORT DROPDOWN */}
        <div className="ml-auto flex items-center gap-4 relative" ref={sortRef}>
          <span className="text-[10px] font-black uppercase tracking-widest text-neutral-600">Sort By</span>
          <button 
            onClick={() => setIsSortOpen(!isSortOpen)}
            className={`flex items-center gap-3 px-1 py-1 group transition-all`}
          >
            <span className={`text-[11px] font-black tracking-tight text-white uppercase`}>{sortBy}</span>
            <ChevronDown className={`w-4 h-4 text-neutral-500 transition-transform ${isSortOpen ? 'rotate-180 text-white' : 'group-hover:text-white'}`} />
          </button>

          {isSortOpen && (
            <div className="absolute top-full right-0 mt-2 w-64 bg-[#0d0d0d] border border-[#222222] rounded-sm shadow-[0_12px_40px_rgba(0,0,0,0.9)] py-1.5 z-[100] animate-in fade-in slide-in-from-top-2 duration-200">
              {sortGroups.map((group, gIdx) => (
                <div key={group.label}>
                  <div className="px-4 py-2 text-[8px] font-black uppercase tracking-[0.2em] text-neutral-600">
                    {group.label}
                  </div>
                  {group.options.map((opt) => (
                    <button
                      key={opt}
                      onClick={() => { setSortBy(opt); setIsSortOpen(false); }}
                      className={`w-full flex items-center justify-between px-4 py-2 text-[10px] font-bold tracking-tight transition-colors hover:bg-[#1a1a1a] ${sortBy === opt ? 'text-white' : 'text-neutral-500 hover:text-white'}`}
                    >
                      <span className="uppercase">{opt}</span>
                      {sortBy === opt && <Check className="w-3.5 h-3.5 text-white" />}
                    </button>
                  ))}
                  {gIdx < sortGroups.length - 1 && <div className="mx-2 my-1.5 h-[1px] bg-white/5" />}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* Main Table Container */}
      <main className="flex-grow overflow-auto no-scrollbar">
        <table className="w-full border-separate border-spacing-0">
          <thead className="sticky top-0 z-10">
            <tr className={`${isDark ? 'bg-[#111111]' : 'bg-neutral-100'} border-b ${borderColor}`}>
              <th className={`text-left py-4 px-6 text-[10px] font-bold text-neutral-500 uppercase tracking-widest min-w-[240px] border-b border-inherit`}>Market Topic</th>
              <th className={`text-right py-4 px-4 text-[10px] font-bold text-neutral-500 uppercase tracking-widest border-b border-inherit`}>Liquidity</th>
              <th className={`text-right py-4 px-4 text-[10px] font-black ${isDark ? 'text-white bg-white/5' : 'text-neutral-900 bg-neutral-200'} uppercase tracking-widest border-b border-white/10 w-[190px]`}>24H Vol Flow</th>
              <th className={`text-right py-4 px-4 text-[10px] font-bold text-neutral-500 uppercase tracking-widest border-b border-inherit`}>OI Size</th>
              <th className={`text-center py-4 px-4 text-[10px] font-bold text-neutral-500 uppercase tracking-widest border-b border-inherit`}>Price (Y/N)</th>
              <th className={`text-center py-4 px-4 text-[10px] font-bold text-neutral-500 uppercase tracking-widest min-w-[660px] border-b border-inherit`}>Position Behavior (24h OI Delta)</th>
              <th className={`text-center py-4 px-4 text-[10px] font-bold text-neutral-500 uppercase tracking-widest border-b border-inherit`}>Signal</th>
              <th className={`text-right py-4 px-6 text-[10px] font-bold text-neutral-500 uppercase tracking-widest border-b border-inherit`}>Updated</th>
            </tr>
          </thead>
          <tbody className={`divide-y ${isDark ? 'divide-[#1a1a1a]' : 'divide-neutral-200'}`}>
            {filteredAndSortedMarkets.map((m) => {
              const volFlowStyles = getMagnitudeStyles(m.vol24hPercent, 'percent');
              const yesDeltaStyles = getMagnitudeStyles(m.yesOIChangeRaw, 'currency');
              const noDeltaStyles = getMagnitudeStyles(m.noOIChangeRaw, 'currency');

              return (
                <tr key={`${m.id}-${m.title}`} className={`group transition-all ${isDark ? 'hover:bg-[#111111]' : 'hover:bg-neutral-100/50'}`}>
                  {/* Column 1: Market Details */}
                  <td className={`py-6 px-6 border-r ${borderColor}`}>
                    <div className="flex flex-col">
                      <span className={`${primaryText} font-bold text-[13px] tracking-tight transition-colors`}>{m.title}</span>
                      <div className="flex gap-2 items-center mt-1">
                        <span className="text-[9px] text-neutral-500 font-black uppercase tracking-wider">{m.category}</span>
                        <span className={`w-0.5 h-0.5 rounded-full ${isDark ? 'bg-neutral-700' : 'bg-neutral-300'}`} />
                        <span className="text-[9px] text-neutral-500 font-medium uppercase">{m.expiry}</span>
                      </div>
                    </div>
                  </td>

                  {/* Column 2: Liquidity */}
                  <td className={`py-6 px-4 text-right font-mono text-[11px] tabular-nums ${isDark ? 'text-neutral-300 font-bold' : 'text-neutral-700'}`}>{m.liquidity}</td>
                  
                  {/* Column 3: Flow */}
                  <td className={`py-6 px-4 text-right bg-white/[0.02] ${volFlowStyles.brightness}`}>
                    <div className="flex flex-col items-end gap-1">
                      <div className="flex items-center gap-2">
                        {volFlowStyles.icon}
                        <span className={volFlowStyles.text}>
                          {m.vol24hPercent > 0 ? '+' : ''}{m.vol24hPercent}%
                        </span>
                      </div>
                      <span className="text-[9px] text-neutral-500 font-mono font-bold">{m.vol24hAbsolute}</span>
                    </div>
                  </td>

                  {/* Column 4: OI Size */}
                  <td className={`py-6 px-4 text-right font-mono text-[11px] tabular-nums ${primaryText} font-bold`}>{m.openInterest}</td>
                  
                  {/* Column 5: Prices */}
                  <td className={`py-6 px-4 text-center border-x ${borderColor}`}>
                    <div className="flex items-center justify-center gap-3 text-[11px] font-mono font-black tracking-tighter tabular-nums opacity-90 group-hover:opacity-100 transition-opacity">
                      <span className="text-emerald-500">${m.yesPrice.toFixed(2)}</span>
                      <span className={isDark ? 'text-neutral-700' : 'text-neutral-300'}>/</span>
                      <span className="text-rose-500">${m.noPrice.toFixed(2)}</span>
                    </div>
                  </td>

                  {/* Column 6: Advanced OI Delta Module */}
                  <td className={`py-6 px-10 relative overflow-hidden ${isDark ? 'bg-[#080808]' : 'bg-slate-50/20'}`}>
                    <div className="flex flex-col items-center gap-3 relative z-10">
                      <div className="flex justify-between w-[380px] text-[8px] font-black font-mono tracking-[0.2em] uppercase opacity-70">
                        <span className={isDark ? 'text-neutral-200' : 'text-neutral-500'}>YES {m.yesRatio}%</span>
                        <span className={isDark ? 'text-neutral-200' : 'text-neutral-500'}>NO {m.noRatio}%</span>
                      </div>

                      <div className="flex items-center gap-12 relative w-full justify-center">
                        <div className={`flex flex-col items-end min-w-[130px] transition-all`}>
                          <div className={`flex items-center gap-2 ${yesDeltaStyles.text}`}>
                            {yesDeltaStyles.icon}
                            {m.yesOIChange}
                          </div>
                          <span className="text-[10px] font-mono text-neutral-500 font-bold tracking-tighter uppercase opacity-80 mt-1">Total: {m.yesOI}</span>
                        </div>

                        {/* Animated Structural Bar */}
                        <div className={`relative w-[380px] h-[10px] rounded-full overflow-hidden flex ${isDark ? 'bg-white/[0.08] border border-white/[0.15]' : 'bg-neutral-200 shadow-inner'}`}>
                          <div className={`h-full transition-all duration-700 relative ${isDark ? 'bg-emerald-900/60' : 'bg-emerald-200'}`} style={{ width: `${m.yesRatio}%` }}>
                            {m.yesOIChangeRaw > 0 && (
                              <div className="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-emerald-500/0 via-emerald-500/60 to-emerald-500/0 animate-flow-streak-right" />
                            )}
                          </div>
                          <div className={`h-full transition-all duration-700 relative ${isDark ? 'bg-rose-900/60' : 'bg-rose-200'}`} style={{ width: `${m.noRatio}%` }}>
                             {m.noOIChangeRaw > 0 && (
                              <div className="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-l from-rose-500/0 via-rose-500/60 to-rose-500/0 animate-flow-streak-left" />
                            )}
                          </div>
                          <div className={`absolute left-1/2 top-0 bottom-0 w-[1.5px] ${isDark ? 'bg-white/40' : 'bg-neutral-400'} z-20`}></div>
                        </div>

                        <div className={`flex flex-col items-start min-w-[130px] transition-all`}>
                          <div className={`flex items-center gap-2 ${noDeltaStyles.text}`}>
                            {noDeltaStyles.icon}
                            {m.noOIChange}
                          </div>
                          <span className="text-[10px] font-mono text-neutral-500 font-bold tracking-tighter uppercase opacity-80 mt-1">Total: {m.noOI}</span>
                        </div>
                      </div>
                    </div>
                  </td>

                  {/* Column 7: Signal Tags */}
                  <td className="py-6 px-4 text-center">
                     <div className="relative group/tooltip inline-block">
                      <span className={`inline-block px-3 py-1.5 rounded-[2px] border text-[9px] font-black tracking-widest transition-all cursor-default ${signalMetadata[m.state]?.color || 'border-neutral-700 text-neutral-400'}`}>{m.state}</span>
                      <div className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-52 p-4 ${isDark ? 'bg-[#0d0d0d] border-[#222222]' : 'bg-white border-neutral-300'} border rounded-sm shadow-2xl opacity-0 invisible group-hover/tooltip:opacity-100 group-hover/tooltip:visible transition-all z-[60]`}>
                        <div className="flex flex-col gap-2 text-left">
                          <span className="text-[8px] font-bold text-neutral-500 uppercase tracking-[0.2em] border-b border-inherit pb-1 mb-1">State Definition</span>
                          <span className={`text-[10px] font-black tracking-tighter text-white uppercase`}>{signalMetadata[m.state]?.sub}</span>
                          <div className="flex flex-col gap-1 pt-1">
                            <span className="text-[8px] font-bold text-neutral-500 uppercase">Structural Triggers</span>
                            {signalMetadata[m.state]?.triggers.map((t, i) => (
                              <div key={i} className="flex justify-between text-[9px]"><span className="text-neutral-400">• {t}</span></div>
                            ))}
                          </div>
                        </div>
                        <div className={`absolute top-full left-1/2 -translate-x-1/2 border-x-[7px] border-x-transparent border-t-[7px] ${isDark ? 'border-t-[#222222]' : 'border-t-neutral-300'}`} />
                      </div>
                    </div>
                  </td>

                  <td className="py-6 px-6 text-right font-mono text-[11px] text-neutral-500 tabular-nums whitespace-nowrap">{m.lastTrade}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </main>

      {/* Footer */}
      <footer className={`h-8 ${isDark ? 'bg-[#111111]' : 'bg-slate-100'} border-t ${borderColor} flex items-center px-6 shrink-0 transition-colors duration-200`}>
        <div className="flex items-center gap-6">
          <div className="flex items-center gap-2 text-emerald-500">
            <span className="w-1.5 h-1.5 rounded-full bg-current animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.5)]"></span>
            <span className="text-[9px] font-black uppercase tracking-[0.2em]">Global Market Pulse Stream Active</span>
          </div>
          <div className={`h-3 w-[1px] ${borderColor}`} />
          <div className="text-[9px] font-bold text-neutral-500 uppercase tracking-widest flex gap-6">
            <span className="flex gap-2">POOLS: <span className={isDark ? 'text-white' : 'text-neutral-900'}>1,402</span></span>
            <span className="flex gap-2">TVL: <span className={isDark ? 'text-white' : 'text-neutral-900'}>$4.1B</span></span>
            <span className="flex gap-2 text-emerald-500 uppercase">Real-Time Flow: <span className="font-black animate-pulse">Detecting</span></span>
          </div>
        </div>
      </footer>
    </div>
  );
};

export default App;
